# Copy this file to .env and fill these in for local development.
# All three are required -- the app has no local-file fallback anymore.

# Which facility row this deployment serves (matches a row's `id` in the
# facilities table -- e.g. "fora" or "jp"). Each facility gets its own
# deployment, but they all share the same Supabase project below.
FACILITY_SLUG=fora

# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
