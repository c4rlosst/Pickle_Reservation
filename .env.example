# Copy this file to .env and fill these in for local development.
# All three are required -- the app has no local-file fallback anymore.

# Which facility row this deployment serves (matches a row's `id` in the
# facilities table -- e.g. "fora" or "jp"). Each facility gets its own
# deployment, but they all share the same Supabase project below.
FACILITY_SLUG=fora

# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000

# Optional -- both have sane defaults if you leave them out.
# Flat fee (in pesos) charged once per booking transaction, on top of the
# courts total. Same across every facility.
PLATFORM_FEE_PHP=10
# How many minutes a customer's selected slot(s) stay reserved for them
# once they open the payment screen, before they've uploaded a screenshot.
HOLD_MINUTES=5

# Telegram booking notifications (optional). One shared bot serves every
# facility -- get a token by messaging @BotFather on Telegram, /newbot,
# and following the prompts. Leave blank to leave notifications off; the
# admin panel will say they're not configured rather than erroring.
TELEGRAM_BOT_TOKEN=
# The bot's own @username (without the @), e.g. "fora_booking_bot". Optional
# -- only used to build a one-tap link in the admin panel; without it the
# admin panel just tells them to message the bot manually, which works the
# same either way.
TELEGRAM_BOT_USERNAME=
